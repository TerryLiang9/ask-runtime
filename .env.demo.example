EMATA_API_HOST=0.0.0.0
EMATA_API_PORT=8000
EMATA_CONSOLE_PORT=3000
EMATA_API_BASE_URL=http://api:8000
NEXT_PUBLIC_EMATA_API_BASE_URL=http://127.0.0.1
EMATA_CORS_ALLOW_ORIGINS=http://127.0.0.1

EMATA_DATABASE_URL=sqlite:////workspace/data/emata.db
EMATA_STORAGE_BACKEND=filesystem
EMATA_UPLOAD_BASE_DIR=/workspace/tmp/uploads

EMATA_REDIS_URL=redis://redis:6379/0
EMATA_TEMPORAL_TARGET=temporal:7233
EMATA_TEMPORAL_NAMESPACE=default
EMATA_MILVUS_URI=http://milvus:19530
EMATA_MILVUS_COLLECTION=emata_documents

EMATA_MINERU_EXECUTABLE=mineru
EMATA_MINERU_BACKEND=pipeline
EMATA_MINERU_METHOD=auto
EMATA_MINERU_LANG=ch
EMATA_MINERU_TIMEOUT_SECONDS=600
EMATA_INSTALL_MINERU_RUNTIME=false

EMATA_MODEL_PROVIDER=qwen
EMATA_MODEL_MODE=openai-compatible
EMATA_MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMATA_MODEL_API_KEY=replace-me
EMATA_MODEL_NAME=qwen3.5-flash

EMATA_RERANK_BASE_URL=https://dashscope.aliyuncs.com/compatible-api/v1
EMATA_RERANK_API_KEY=replace-me
EMATA_RERANK_MODEL=qwen3-rerank

EMATA_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMATA_EMBEDDING_API_KEY=replace-me
EMATA_EMBEDDING_MODEL=text-embedding-async-v1
EMATA_EMBEDDING_DIMENSION=1024

EMATA_FEISHU_MCP_ENABLED=false
EMATA_FEISHU_MCP_EXECUTABLE=npx
EMATA_FEISHU_MCP_PACKAGE=@larksuiteoapi/lark-mcp
EMATA_FEISHU_MCP_TRANSPORT=stdio
EMATA_FEISHU_APP_ID=
EMATA_FEISHU_APP_SECRET=
EMATA_DEFAULT_INTERNAL_CHAT_QUERY=internal-collab-group
